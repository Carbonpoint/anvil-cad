{
  "name": "stress_plate",
  "features": [
    {
      "feature": {
        "type": "box",
        "x": "0",
        "y": "0",
        "z": "0",
        "width": "plate_x",
        "depth": "plate_y",
        "height": "plate_z"
      },
      "suppressed": false
    },
    {
      "feature": {
        "type": "lattice_fill",
        "body": 0,
        "lattice": "cubic",
        "cell": "10",
        "wall": "wall_low",
        "wall_end": "wall_high",
        "cell_end": "0",
        "grade": "map",
        "conform": "none",
        "ref_body": 0,
        "map_file": "docs/tutorials/files/stress.csv",
        "map_lo": "map_lo",
        "map_hi": "map_hi",
        "skin": "0",
        "resolution": "res"
      },
      "suppressed": false
    }
  ],
  "exprs": {
    "params": {
      "plate_x": { "name": "plate_x", "source": "60", "value": 0.0 },
      "plate_y": { "name": "plate_y", "source": "40", "value": 0.0 },
      "plate_z": { "name": "plate_z", "source": "20", "value": 0.0 },
      "res": { "name": "res", "source": "0.5", "value": 0.0 },
      "wall_low": { "name": "wall_low", "source": "1", "value": 0.0 },
      "wall_high": { "name": "wall_high", "source": "3", "value": 0.0 },
      "map_lo": { "name": "map_lo", "source": "70", "value": 0.0 },
      "map_hi": { "name": "map_hi", "source": "250", "value": 0.0 }
    }
  },
  "unit": "mm"
}
